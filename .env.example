# /home/st9797/.openclaw/workspace/agents/coding/kya-service/.env.example
#
# KYA Service — Environment Variable Template
#
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
#
# Licensed under AGPL-3.0 — See LICENSE file for details.

# ─── Server ─────────────────────────────────────────────────────────────────
# Port the Hono server listens on (3000 = default)
PORT=3000

# Bind address (0.0.0.0 for containers, 127.0.0.1 for local)
HOSTNAME=0.0.0.0

# Node environment
NODE_ENV=production

# ─── Watchlists / Sanctions Data ────────────────────────────────────────────
# Directory for watchlist data files (runtime only)
# In containers this is /app/data — override only for dev
KYA_DATA_DIR=./data

# ─── Supabase (optional — for KYC / wallet identity storage) ───────────────
# Supabase project URL (https://<project>.supabase.co)
SUPABASE_URL=

# Supabase anon/public API key
SUPABASE_ANON_KEY=

# Supabase service role key (server-side only — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Algorand (optional — for wallet graph / transaction history) ──────────
# Algorand REST API endpoint (mainnet / testnet / sandbox)
ALGORAND_NETWORK_URL=

# Algorand REST API token (required for v2 API)
ALGORAND_API_TOKEN=

# Indexer API URL (if using separate indexer)
ALGORAND_INDEXER_URL=

# Indexer API token (required for v2 API)
ALGORAND_INDEXER_TOKEN=

# ─── Screening Configuration (defaults can also be set at startup) ─────────
# Confidence threshold: >= this value → FAIL (block)
SCREENING_FAIL_THRESHOLD=0.85

# Confidence threshold: >= this value → FLAGGED (review)
SCREENING_FLAG_THRESHOLD=0.50

# Maximum match candidates per screening
SCREENING_MAX_RESULTS=10

# Fuzzy match similarity tolerance (0–1)
SCREENING_FUZZY_TOLERANCE=0.80

# Enable alias matching
SCREENING_MATCH_ALIASES=true

# Enable national ID matching
SCREENING_MATCH_NATIONAL_IDS=true

# Enable address matching
SCREENING_MATCH_ADDRESSES=true

# ─── Verification Providers (optional — for KYC flow) ─────────────────────
# Email provider settings (e.g., SendGrid, Postmark, Resend)
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=KYA Service <noreply@example.com>

# ─── Logging ────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info
